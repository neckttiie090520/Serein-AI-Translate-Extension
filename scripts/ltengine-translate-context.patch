+#[post("/translate-context")]
+async fn translate_context(
+    req: HttpRequest,
+    payload: web::Payload,
+    args: web::Data<Arc<Args>>,
+    llm: actix_web::web::Data<Arc<llm::LLM>>,
+) -> Result<HttpResponse, ErrorResponse> {
+    let body = actix_web::web::Json::<TranslateContextRequest>::from_request(&req, &mut payload.into_inner())
+        .await
+        .map_err(|e| ErrorResponse { error: format!("Invalid JSON body: {e}"), status: 400 })?
+        .into_inner();
+
+    let q = body.q.clone().ok_or_else(|| ErrorResponse {
+        error: "Invalid request: missing q parameter".to_string(),
+        status: 400,
+    })?;
+    let target = body.target.clone().ok_or_else(|| ErrorResponse {
+        error: "Invalid request: missing target parameter".to_string(),
+        status: 400,
+    })?;
+    if q.trim().is_empty() || target.trim().is_empty() {
+        return Err(ErrorResponse { error: "Invalid request: empty q or target".to_string(), status: 400 });
+    }
+    if !args.api_key.is_empty() && body.api_key.as_ref().is_none_or(|key| *key != args.api_key) {
+        return Err(ErrorResponse { error: "Invalid API key".to_string(), status: 403 });
+    }
+    if q.len() > args.char_limit {
+        return Err(ErrorResponse {
+            error: format!("Invalid request: request ({}) exceeds text limit ({})", q.len(), args.char_limit),
+            status: 400,
+        });
+    }
+
+    let tgt_lang = get_language_from_code(&target).ok_or_else(|| ErrorResponse {
+        error: format!("{} is not supported", target),
+        status: 400,
+    })?;
+
+    let context_block = body
+        .context
+        .unwrap_or_default()
+        .iter()
+        .map(|line| line.trim())
+        .filter(|line| !line.is_empty())
+        .take(12)
+        .collect::<Vec<_>>()
+        .join("\n");
+
+    let system = "You are an expert linguist, specializing in translation. You are given a conversation for context and one final message. Translate ONLY the final message, using the conversation to resolve pronouns, names, tone and ambiguous wording. You never translate or repeat the context. You never provide explanations for your work. You always answer with the translated text and nothing else.".to_string();
+    let user = if context_block.is_empty() {
+        format!("Translate the text below to {}.\n\nText: {}\n\n{}:\n", tgt_lang.name, q, tgt_lang.name)
+    } else {
+        format!(
+            "Conversation so far (context only, do not translate or repeat it):\n{}\n\nTranslate only the final message below to {}.\n\nText: {}\n\n{}:\n",
+            context_block, tgt_lang.name, q, tgt_lang.name
+        )
+    };
+
+    let llm = llm.get_ref();
+    let translated_text = llm.run_prompt(system, user).map_err(|e| {
+        let status = if e.is::<llm::LLMError>() { 503 } else { 500 };
+        let msg = format!("{:#}", e);
+        eprintln!("translation error: {}", msg);
+        ErrorResponse { error: msg, status }
+    })?;
+
+    let mut response = serde_json::json!({ "translatedText": improve_formatting(&q, &translated_text) });
+    if body.source.as_deref().unwrap_or("auto") == "auto" {
+        let d = detect_lang(&q);
+        response["detectedLanguage"] = serde_json::json!({
+            "language": d.language.code,
+            "confidence": d.confidence
+        });
+    }
+
+    Ok(HttpResponse::Ok().json(response))
+}
